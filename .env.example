# ──────────────────────────────────────────────────────────────────
# CORE
# ──────────────────────────────────────────────────────────────────
NODE_ENV=development
LOG_LEVEL=info
APP_BASE_URL=http://localhost:3000
MARKETING_BASE_URL=http://localhost:3001
TENANT_DEFAULT_PLAN=starter

# ──────────────────────────────────────────────────────────────────
# POSTGRESQL
# ──────────────────────────────────────────────────────────────────
DATABASE_URL=postgresql://copilot:copilot@localhost:5432/operations_copilot
DATABASE_POOL_MIN=2
DATABASE_POOL_MAX=20

# ──────────────────────────────────────────────────────────────────
# MONGO (documents, AI embeddings, audit event archive)
# ──────────────────────────────────────────────────────────────────
MONGO_URI=mongodb://localhost:27017
MONGO_DB=operations_copilot

# ──────────────────────────────────────────────────────────────────
# REDIS (BullMQ queues, rate limit, pub/sub, cache)
# ──────────────────────────────────────────────────────────────────
REDIS_URL=redis://localhost:6379/0

# ──────────────────────────────────────────────────────────────────
# OBJECT STORE (MinIO in dev, S3/Azure Blob/GCS in prod)
# ──────────────────────────────────────────────────────────────────
S3_ENDPOINT=http://localhost:9000
S3_REGION=us-east-1
S3_ACCESS_KEY=copilot
S3_SECRET_KEY=copilotsecret
S3_BUCKET_DOCS=opscopilot-docs
S3_BUCKET_AVATARS=opscopilot-avatars
S3_BUCKET_EXPORTS=opscopilot-exports
S3_FORCE_PATH_STYLE=true

# ──────────────────────────────────────────────────────────────────
# SEARCH
# ──────────────────────────────────────────────────────────────────
ELASTICSEARCH_URL=http://localhost:9200
ELASTICSEARCH_USERNAME=elastic
ELASTICSEARCH_PASSWORD=devpassword

# ──────────────────────────────────────────────────────────────────
# AUTH / SECURITY
# ──────────────────────────────────────────────────────────────────
JWT_SECRET=change-me-32-bytes-random-key-operations-copilot
JWT_ACCESS_TTL=900
JWT_REFRESH_TTL=2592000
COOKIE_SECURE=false
COOKIE_SAMESITE=lax
PASSWORD_BCRYPT_ROUNDS=12
MFA_ISSUER=OperationsCopilot
SESSION_INACTIVITY_TIMEOUT=1800

# ──────────────────────────────────────────────────────────────────
# OAUTH / SSO
# ──────────────────────────────────────────────────────────────────
OIDC_GOOGLE_CLIENT_ID=demo_google_id
OIDC_GOOGLE_CLIENT_SECRET=demo_google_secret
OIDC_MICROSOFT_CLIENT_ID=demo_ms_id
OIDC_MICROSOFT_CLIENT_SECRET=demo_ms_secret
SAML_ENTRY_POINT=http://localhost:8080/saml
SAML_ISSUER=operations-copilot
SAML_CERT=demo_cert

# ──────────────────────────────────────────────────────────────────
# LLM PROVIDERS
# ──────────────────────────────────────────────────────────────────
LLM_PROVIDER_OPENAI_API_KEY=
LLM_PROVIDER_OPENAI_MODEL_DEFAULT=gpt-4o
LLM_PROVIDER_ANTHROPIC_API_KEY=
LLM_PROVIDER_ANTHROPIC_MODEL_DEFAULT=claude-3-5-sonnet-latest
LLM_PROVIDER_GOOGLE_API_KEY=
LLM_PROVIDER_GOOGLE_MODEL_DEFAULT=gemini-1.5-pro

# ──────────────────────────────────────────────────────────────────
# EMBEDDINGS / VECTOR STORE
# ──────────────────────────────────────────────────────────────────
EMBEDDING_PROVIDER=openai
EMBEDDING_MODEL=text-embedding-3-small
VECTOR_STORE=pgvector
VECTOR_DIM=1536

# ──────────────────────────────────────────────────────────────────
# BILLING
# ──────────────────────────────────────────────────────────────────
STRIPE_SECRET_KEY=sk_test_mock
STRIPE_WEBHOOK_SECRET=whsec_mock
STRIPE_PRICE_STARTER=price_starter
STRIPE_PRICE_GROWTH=price_growth
STRIPE_PRICE_ENTERPRISE=price_enterprise

# ──────────────────────────────────────────────────────────────────
# FEATURE FLAGS
# ──────────────────────────────────────────────────────────────────
FF_AI_ASSISTANT=true
FF_VISUAL_WORKFLOW_BUILDER=true
FF_PREDICTIVE_SLA=true
FF_RISK_DETECTION=true
FF_BUSINESS_INTELLIGENCE=true
